# Copie para ".env" e ajuste. O arquivo .env NÃO deve ser enviado ao GitHub.
CLINICA_NOME="Nutri Saúde Integral"
PRO_NOME="Nome do Profissional"
PRO_TITULO="Nutricionista"
PRO_REGISTRO="CRN 0-00000000"
DPO_CONTATO="seu-email@exemplo.com.br"

# Onde ficam o banco de dados e as chaves de criptografia.
# Em HD portátil: mantenha as CHAVES fora do HD (ou em outro pendrive) e criptografe o HD.
NUTRI_DATA_DIR=./dados
NUTRI_KEYS_DIR=./chaves

# Somente em servidor com HTTPS:
# NUTRI_ENV=production
# DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco
